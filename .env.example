# Выбор хранилища: inmemory или postgres
STORAGE_TYPE=postgres

# PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5499/shorty

# Redis (закомментируйте для отключения кеша)
REDIS_URL=redis://localhost:6379
# DISABLE_REDIS=true

# Сервер
LISTEN_ADDR=0.0.0.0:8080

# Логи: json или пусто (pretty)
LOG_FORMAT=json

# Кеш
CACHE_TTL_SECS=60
CACHE_JITTER_SECS=10
CACHE_OP_TIMEOUT_MS=300

# Rate limiting
RATE_LIMIT_CAPACITY=10
RATE_LIMIT_PERIOD_SECS=60
RATE_LIMIT_CLEANUP_TTL_SECS=120

# Настройки кода
CODE_LENGTH=8
MAX_GENERATE_ATTEMPTS=5
REQUEST_TIMEOUT_SECS=5
MAX_BODY_BYTES=16384

# Tokio
SHORTY_WORKER_THREADS=4

# Уровень логирования
RUST_LOG=info,sqlx=warn