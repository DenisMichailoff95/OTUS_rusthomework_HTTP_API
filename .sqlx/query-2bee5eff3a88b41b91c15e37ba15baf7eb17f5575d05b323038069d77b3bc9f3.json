{
  "db_name": "PostgreSQL",
  "query": "\n                    SELECT id, code, target_url, created_at, updated_at, expires_at, version, hits\n                    FROM links\n                    WHERE created_at < $1 OR (created_at = $1 AND code < $2)\n                    ORDER BY created_at DESC, code DESC\n                    LIMIT $3\n                    ",
